# The upstream Laravel API. Leave EMPTY to run `server/api` against its
# in-memory mock (the default while the real API is being built).
#
# Set it to switch every route to proxy mode — no application code changes.
# Include the version prefix if there is one, e.g. https://api.vertex.test/api/v1
NUXT_API_BASE_URL=

# Sent as `Authorization: Bearer <token>` on every upstream request.
# Leave empty if the API is public or uses cookie/session auth instead, in
# which case server/utils/backend.ts needs the credential handling adjusted.
NUXT_API_TOKEN=
