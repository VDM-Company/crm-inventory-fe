# ── the Vertex Commerce API ───────────────────────────────────────────────────
# Include the /api/v1 prefix. Without it every path 404s.
# Postman mock from the collection (static examples; writes do not persist):
NUXT_VERTEX_API_BASE=https://557ff511-6521-4b53-8fa4-dbd7aa8ac13b.mock.pstmn.io/api/v1
# Bearer token from POST /admin/auth/login. The mock ignores it; the real API
# answers 401 without one. Server-only — never expose it to the browser.
NUXT_VERTEX_API_TOKEN=

# ── the old seam, for the resources not migrated yet ──────────────────────────
# Leave empty to serve them from the in-memory mock in server/utils/mock-db.ts.
NUXT_API_BASE_URL=
NUXT_API_TOKEN=
