# ── the Vertex Commerce API ───────────────────────────────────────────────────
# Include the /api/v1 prefix. Without it every path 404s.
# Postman mock from the collection (static examples; writes do not persist):
NUXT_VERTEX_API_BASE=https://557ff511-6521-4b53-8fa4-dbd7aa8ac13b.mock.pstmn.io/api/v1

# ── session ───────────────────────────────────────────────────────────────────
# Seals the cookie that holds each signed-in user's API token, so the token is
# never readable by the browser. At least 32 characters. `nuxt-auth-utils`
# writes a generated one here on the first dev run, so leaving it blank is
# fine locally; a deployed environment needs a real secret of its own.
# Server-only. Changing it signs everyone out.
NUXT_SESSION_PASSWORD=
